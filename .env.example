# --- Postgres (system of record) ---
DATABASE_URL=postgresql://lomi:lomi@localhost:5432/lomi

# --- Redis (BullMQ coordination only) ---
REDIS_URL=redis://localhost:6379

# --- Object storage (S3-compatible; SeaweedFS locally) ---
S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_BUCKET=documents
S3_ACCESS_KEY_ID=localdev
S3_SECRET_ACCESS_KEY=localdev12345
S3_FORCE_PATH_STYLE=true

# --- LLM via OpenRouter ---
OPENROUTER_API_KEY=
# Default model; pick from `pnpm eval:models` results
EXTRACTION_MODEL=anthropic/claude-sonnet-5.5

# --- API ---
API_PORT=4000
# Comma-separated origins allowed by CORS (the browser calls the API directly)
CORS_ORIGINS=http://localhost:3000

# --- Web ---
NEXT_PUBLIC_API_URL=http://localhost:4000
