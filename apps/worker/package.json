{
  "name": "@lomi/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@lomi/core": "workspace:*",
    "@lomi/db": "workspace:*",
    "@lomi/extraction": "workspace:*",
    "@lomi/queue": "workspace:*",
    "@lomi/storage": "workspace:*",
    "bullmq": "6.7.10",
    "@lomi/services": "workspace:*"
  },
  "devDependencies": {
    "@lomi/eslint-config": "workspace:*",
    "@lomi/tsconfig": "workspace:*",
    "@types/node": "26.6.11",
    "eslint": "10.15.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.1.2"
  }
}
