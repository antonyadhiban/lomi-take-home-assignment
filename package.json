{
  "name": "lomi-take-home",
  "private": true,
  "packageManager": "pnpm@10.8.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "db:migrate": "pnpm --filter @lomi/db migrate:deploy",
    "eval:models": "pnpm --filter @lomi/extraction eval"
  },
  "devDependencies": {
    "turbo": "2.11.13",
    "typescript": "6.0.3"
  }
}
