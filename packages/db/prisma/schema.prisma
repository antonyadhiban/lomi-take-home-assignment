// Postgres is the system of record. Redis (BullMQ) only coordinates work;
// everything a user can see — versions, run outcomes, values, reviews — is here.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum VersionStatus {
  queued
  extracting
  extracted
  failed
  superseded // a newer version arrived before this one finished
}

enum RunStatus {
  queued
  running
  succeeded
  failed
  cancelled
}

/// Effective review state of a value after an event (denormalized onto every
/// event so the latest event alone answers "what state is this value in").
enum ReviewState {
  pending
  approved
  corrected
}

enum ReviewKind {
  approved
  corrected
  restored     // undo/redo/restore: re-applies an earlier state (or back to pending)
  carried_over // copied from the previous version because evidence + value were unchanged
  undone       // undo: reverses the event in sourceEventId (undo/redo stacks are replayed from the log)
  redone       // redo: re-applies the undone event in sourceEventId
}

model Document {
  id               String            @id @default(cuid())
  type             String // invoice | lease | market_report (validated in @lomi/core)
  title            String
  createdAt        DateTime          @default(now())
  /// newest uploaded version (may still be extracting)
  currentVersionId String?           @unique
  currentVersion   DocumentVersion?  @relation("CurrentVersion", fields: [currentVersionId], references: [id])
  versions         DocumentVersion[] @relation("Versions")
}

model DocumentVersion {
  id          String          @id @default(cuid())
  documentId  String
  document    Document        @relation("Versions", fields: [documentId], references: [id])
  currentOf   Document?       @relation("CurrentVersion")
  version     Int
  status      VersionStatus   @default(queued)
  /// S3 object key of the original PDF
  storageKey  String
  sha256      String
  /// parsed once and stored, so evidence checks and the review UI for version N
  /// keep working after N+1 exists
  parsedText  String?
  /// last user-visible failure (copied from the failing run)
  error       String?
  createdAt   DateTime        @default(now())
  runs        ExtractionRun[]
  values      ExtractedValue[]

  @@unique([documentId, version])
  @@index([status])
}

/// One attempt to extract a version. The reconciler uses status + leaseUntil to
/// find work that Redis forgot (restart, FLUSHALL) and re-enqueue it.
model ExtractionRun {
  id          String          @id @default(cuid())
  versionId   String
  version     DocumentVersion @relation(fields: [versionId], references: [id])
  attempt     Int
  status      RunStatus       @default(queued)
  leaseUntil  DateTime?
  /// random token set on every claim; a commit only lands if the token still
  /// matches, so a worker whose lease expired can't overwrite a newer claim
  claimToken  String?
  /// how many times a worker has claimed this run (crash loops -> failed)
  claims      Int             @default(0)
  model       String?
  prompt      String?
  rawResponse Json?
  error       String?
  createdAt   DateTime        @default(now())
  startedAt   DateTime?
  finishedAt  DateTime?
  values      ExtractedValue[]

  @@unique([versionId, attempt])
  @@index([status, leaseUntil])
}

/// Immutable LLM output. A gap is value = null with gapReason set.
/// Unique (versionId, field) makes extraction idempotent: a second run for the
/// same version can never add duplicate values.
model ExtractedValue {
  id              String          @id @default(cuid())
  versionId       String
  version         DocumentVersion @relation(fields: [versionId], references: [id])
  runId           String
  run             ExtractionRun   @relation(fields: [runId], references: [id])
  field           String
  value           String?
  normalizedValue String?
  evidence        String?
  /// offsets into normalized parsedText, for highlighting
  evidenceStart   Int?
  evidenceEnd     Int?
  gapReason       String?
  /// the same field on the previous extracted version (for "what changed")
  previousValueId String?
  previousValue   ExtractedValue? @relation("PreviousValue", fields: [previousValueId], references: [id])
  nextValues      ExtractedValue[] @relation("PreviousValue")
  createdAt       DateTime        @default(now())
  reviews         ReviewEvent[]

  @@unique([versionId, field])
}

/// Append-only review log (Google-Docs-style history). The latest event per
/// value is its effective state; undo/redo append `restored` events.
model ReviewEvent {
  id             String         @id @default(cuid())
  valueId        String
  value          ExtractedValue @relation(fields: [valueId], references: [id])
  kind           ReviewKind
  /// effective state after this event
  state          ReviewState
  /// effective value after this event: the corrected value when state=corrected,
  /// the extracted value when approved, null when pending
  resultValue    String?
  note           String?
  reviewer       String         @default("reviewer")
  /// for `restored`: the event whose state was re-applied;
  /// for `carried_over`: the event on the previous version that was copied;
  /// for `undone` / `redone`: the event being reversed / re-applied
  sourceEventId  String?
  sourceEvent    ReviewEvent?   @relation("SourceEvent", fields: [sourceEventId], references: [id])
  derivedEvents  ReviewEvent[]  @relation("SourceEvent")
  createdAt      DateTime       @default(now())

  @@index([valueId, createdAt])
}
